def train_qcz(data, N_boots, model_name, save_folder):
    # ✅ ROBUST LABEL EXTRACTION
    raw_labels = data[:, -1]
    labels = np.where(raw_labels >= 0.5, 1, 0).astype(int)
    
    pos_mask = labels == 1
    neg_mask = labels == 0
    
    data_1 = data[pos_mask]
    data_0 = data[neg_mask]
    
    print(f"📊 Data split: {len(data_1)} positive, {len(data_0)} negative")
    
    if len(data_1) == 0 or len(data_0) == 0:
        raise ValueError("One class is missing! Check your label values in the HDF5 file.")
    
    # ... rest of your training logic ...
    
    # ... rest of your training logic ...
    
    np.random.shuffle(data_1)
    np.random.shuffle(data_0)

    ratio = 0.8
    train_N_1 = int(len(data_1) * ratio)
    train_N_0 = int(len(data_0) * ratio)
    
    training = np.concatenate([data_1[:train_N_1], data_0[:train_N_0]], axis=0)
    np.random.shuffle(training)

    testing = np.concatenate([data_1[train_N_1:], data_0[train_N_0:]], axis=0)
    np.random.shuffle(testing)

    all_train_encodings = training[:, :-1]
    all_labels = training[:, -1].astype(int)  # Ensure int for sklearn


    testing = np.concatenate([data_1[train_N_1:], data_0[train_N_0:]], axis=0)
    np.random.shuffle(testing)

    all_train_encodings = training[:, :-1]
    all_labels = training[:, -1].astype(int)  # Ensure int for sklearn
    
    # ... rest of your original code unchanged ...
    # print ('all_labels',np.sum(all_labels==0))
    # print ('all_labels',np.sum(all_labels==1))
    # sys.exit(0)

    if N_boots==1:
        sample_N = all_train_encodings.shape[0]
    else:
        sample_N = int(all_train_encodings.shape[0]*0.8)
        
    boot_models=[]
    for N_boot in range(N_boots):
        print (f'N_boot: {N_boot}')
        random_idx=np.random.permutation(all_train_encodings.shape[0])[:sample_N]
        train_encodings=all_train_encodings[random_idx]
        labels_batch=all_labels[random_idx]
        
        if model_name=='LR':
            from sklearn.preprocessing import StandardScaler
            # Scale data specifically for LR to ensure convergence
            scaler_lr = StandardScaler()
            train_enc_scaled = scaler_lr.fit_transform(train_encodings)
            
            LRC = LogisticRegression(
                random_state=0, 
                max_iter=5000,          # Increased from 1000 to prevent convergence warning
                class_weight='balanced',
                solver='lbfgs'
            )
            LRC.fit(train_enc_scaled, labels_batch)
            # Store scaler with model so prediction can scale test data later
            LRC.scaler_ = scaler_lr 
            LRC.fit(train_encodings, labels_batch) # ✅ Explicit fit
            
        elif model_name=='SVC':
            LRC = SVC(probability=True, kernel='linear', class_weight='balanced')
            LRC.fit(train_encodings, labels_batch) # ✅ Explicit fit
            
        elif model_name=='XGB':
            # Calculate weight for imbalance
            pos_count = np.sum(labels_batch == 1)
            neg_count = np.sum(labels_batch == 0)
            weight = neg_count / pos_count if pos_count > 0 else 1
            
            LRC = XGBClassifier(eval_metric='auc', scale_pos_weight=weight, use_label_encoder=False, random_state=0)
            LRC.fit(train_encodings, labels_batch) # ✅ THIS WAS LIKELY MISSING OR FAILED
                    
        elif model_name=='RF':
            LRC = RandomForestClassifier(n_estimators=100, class_weight='balanced', n_jobs=-1, random_state=0)
            LRC.fit(train_encodings, labels_batch) # ✅ Explicit fit
            
        elif model_name=='ADA':
            LRC = AdaBoostClassifier(n_estimators=100, random_state=0)
            LRC.fit(train_encodings, labels_batch) # ✅ Explicit fit
            
        elif model_name=='KNN':
            LRC = KNeighborsClassifier(n_neighbors=5, metric='cosine')
            LRC.fit(train_encodings, labels_batch) # ✅ Explicit fit

        # Save the fitted model
        directory=os.path.join(save_folder, model_name)
        if not os.path.exists(directory):
            os.makedirs(directory)

        model_file=os.path.join(directory, f"{model_name}{N_boot}.sav")
        pickle.dump(LRC, open(model_file, 'wb'))
        boot_models.append(LRC)

    def boot_prediction(models,X): 
        probs=[]
        for model in models: 
            probs.append(model.predict_proba(X))
        # print (np.shape(probs))       
        probs=np.mean(probs,axis=0)[:,1]
        # print (np.shape(probs))   
        pred_results=probs>0.5
        return probs,pred_results

    # print ('im here')


    train_encodings=training[:,:-1]
    train_labels=training[:,-1]
    probs,pred=boot_prediction(boot_models,train_encodings)   
    # test_label=np.load('test_encoding_y_14.npy')
    train_acc=np.divide(np.sum(train_labels==pred),len(train_labels))
    idx_1=pred==1
    tp=np.sum((pred[idx_1]==train_labels[idx_1]))
    fp=np.sum((pred[idx_1]!=train_labels[idx_1]))
    if (tp+fp)==0:
        precision = 0 
    else:
        precision = tp/(tp+fp)
    print ('stats:','acc',train_acc,'len pred positive',np.sum(idx_1),'precision',precision)
    return boot_models



