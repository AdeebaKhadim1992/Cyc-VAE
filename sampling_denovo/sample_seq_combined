import os
import sys
import pickle
import numpy as np
import pandas as pd
import h5py
import torch
from pathlib import Path

# ==============================================================================
# 1. PORTABLE PROJECT SETUP & PATHS
# ==============================================================================
PROJECT_ROOT = Path(__file__).resolve().parent
print(f"📂 Project Root: {PROJECT_ROOT}")

if str(PROJECT_ROOT) not in sys.path:
    sys.path.insert(0, str(PROJECT_ROOT))

# Import local modules
try:
    from train_sampling_models import train_qcz, train_qz
    from sample_seqs_revise import sampling_seqs
    import VAE_configuration as Params
    from model.model import RNN_VAE
except ImportError as e:
    raise ImportError(f"Failed to import required modules. Ensure all dependencies are installed and paths are correct: {e}")

# Define key directories and files using relative paths
MH_MODELS_FOLDER = PROJECT_ROOT / 'mh_models'
RESULTS_FOLDER = PROJECT_ROOT / 'mh_results'
MODEL_CKPT = PROJECT_ROOT / 'model_best.ckpt'

LABELED_ENC_PATH = MH_MODELS_FOLDER / 'binder_lab_encodings.h5'
UNLABELED_ENC_PATH = MH_MODELS_FOLDER / 'binder_unlabeled_encodings.h5'
LABELED_DATA_PATH = PROJECT_ROOT / 'binder_lab.csv'
LABELED_ENC_PREFIX = str(MH_MODELS_FOLDER / 'binder_lab_encodings')  # Keep as string for legacy compatibility

os.makedirs(RESULTS_FOLDER, exist_ok=True)

# ==============================================================================
# 2. VERIFY REQUIRED FILES
# ==============================================================================
required_files = [
    LABELED_ENC_PATH, UNLABELED_ENC_PATH, 
    LABELED_DATA_PATH, MODEL_CKPT
]

print("\nChecking required files...")
for path in required_files:
    if not path.exists():
        raise FileNotFoundError(
            f"Required file not found: {path}\n"
            f"Please run the encoding scripts first or download assets via scripts/download_assets.py"
        )
print("✅ All required files exist.")

# ==============================================================================
# 3. LOAD AND VALIDATE LABELED CSV DATA
# ==============================================================================
print("\nLoading labeled CSV data...")
label_df = pd.read_csv(str(LABELED_DATA_PATH))

required_columns = {'seq', 'label'}
if not required_columns.issubset(label_df.columns):
    raise ValueError(f"CSV must contain columns {required_columns}. Found: {label_df.columns.tolist()}")

label_df = label_df.dropna(subset=['seq', 'label']).copy()
label_df['seq'] = label_df['seq'].astype(str).str.strip()
label_df = label_df[label_df['seq'] != '']

label_df['label'] = pd.to_numeric(label_df['label'], errors='raise').astype(int)
unique_labels = set(label_df['label'].unique())

if not unique_labels.issubset({0, 1}):
    raise ValueError("Expected binary labels 0 and 1 in binder_lab.csv.")
if unique_labels != {0, 1}:
    raise ValueError("Both label 0 and label 1 must be present in binder_lab.csv.")

print(f"Labeled CSV loaded: {label_df.shape}")
print("Label distribution:")
print(label_df['label'].value_counts().sort_index())

# ==============================================================================
# 4. LOAD PRECOMPUTED ENCODINGS
# ==============================================================================
print("\n########## 1. Loading precomputed encodings ##########")

with h5py.File(str(LABELED_ENC_PATH), 'r') as hf:
    labelled_encodings = np.asarray(hf['data'])

with h5py.File(str(UNLABELED_ENC_PATH), 'r') as hf:
    unlabeled_encodings = np.asarray(hf['data'])

print(f"Labeled encodings shape: {labelled_encodings.shape}")
print(f"Unlabeled encodings shape: {unlabeled_encodings.shape}")

# Validate dimensions
Z_DIM = Params.RNN_VAE_params.get('z_dim', 256)
expected_labeled_cols = Z_DIM + 1
expected_unlabeled_cols = Z_DIM

if labelled_encodings.ndim != 2 or labelled_encodings.shape[1] != expected_labeled_cols:
    raise ValueError(
        f"Labeled encodings must be 2D with {expected_labeled_cols} columns "
        f"({Z_DIM} latent + 1 label). Got {labelled_encodings.shape[1]}."
    )

if unlabeled_encodings.ndim != 2 or unlabeled_encodings.shape[1] != expected_unlabeled_cols:
    raise ValueError(
        f"Unlabeled encodings must be 2D with {expected_unlabeled_cols} columns. "
        f"Got {unlabeled_encodings.shape[1]}."
    )

if not np.isfinite(labelled_encodings).all():
    raise ValueError("Labeled encodings contain NaN or infinity.")
if not np.isfinite(unlabeled_encodings).all():
    raise ValueError("Unlabeled encodings contain NaN or infinity.")

encoding_labels = labelled_encodings[:, -1]
if not np.isin(encoding_labels, [0, 1]).all():
    raise ValueError("The final column of labeled encodings must contain only 0s and 1s.")

print("✅ Encoding dimensions and values verified successfully.")

# ==============================================================================
# 5. TRAIN CLASSIFIER q(c|z)
# ==============================================================================
print("\n########## 2. Training q(c|z) classifier ##########")

qcz_params = {
    'N_boots': 4,
    'model_name': 'XGB',
    'save_folder': str(RESULTS_FOLDER / 'qcz_f1' / 'XGB')
}

to_train_qcz = True

if to_train_qcz:
    print("Training new classifier models...")
    qcz_models = train_qcz(labelled_encodings, **qcz_params)
else:
    print("Loading existing classifier models...")
    qcz_models = []
    qcz_save_dir = Path(qcz_params['save_folder'])

    if not qcz_save_dir.is_dir():
        raise FileNotFoundError(f"Classifier folder not found: {qcz_save_dir}")

    for filename in sorted(qcz_save_dir.iterdir()):
        if filename.suffix == '.pkl':
            with open(str(filename), 'rb') as f:
                qcz_models.append(pickle.load(f))

    if not qcz_models:
        raise FileNotFoundError(f"No saved classifier .pkl files found in {qcz_save_dir}")

print(f"✅ Classifier ready. Number of models: {len(qcz_models)}")

# ==============================================================================
# 6. TRAIN GMM PRIOR q(z)
# ==============================================================================
print("\n########## 3. Training q(z) GMM prior ##########")

qz_params = {
    'model_name': 'GMM',
    'n_components': 5,
    'save_folder': str(RESULTS_FOLDER / 'qz')
}

qz_model = train_qz(unlabeled_encodings, **qz_params)
print("✅ GMM prior training complete.")

# ==============================================================================
# 7. CONFIGURE DE NOVO MH SAMPLING
# ==============================================================================
print("\n########## 4. Configuring de novo MH sampling ##########")

MH_sampling_params = {
    'exploration_rate': [0.05, 0.2],
    'N_chains': 150,
    'burn_in': 50,
    'extension_model': RNN_VAE,
    'model_path': str(MODEL_CKPT),
    'extension_params': Params,
    'labeled_encoding_path': LABELED_ENC_PREFIX,
    'labeled_data_path': str(LABELED_DATA_PATH),
    'base': '',
    'seqs_dict': {i: {} for i in range(7, 34)},
    'lens': list(range(7, 34)),
    'desired_N': [15] * 27,
    'result_file_name': str(RESULTS_FOLDER / 'denovo_mh_results')
}

# ==============================================================================
# 8. RUN METROPOLIS-HASTINGS SAMPLING
# ==============================================================================
print("\n########## 5. Starting MH de novo sampling ##########")

sampling_seqs(
    qcz_models=qcz_models,
    qz_model=qz_model,
    **MH_sampling_params
)

print("\n########## ✅ MH sampling finished successfully ##########")

# ==============================================================================
# 9. OUTPUT SUMMARY
# ==============================================================================
print(f"\nResults saved to: {RESULTS_FOLDER}")
print("Expected output files:")
for length in range(7, 34):
    print(f"  - denovo_mh_results_{length}.txt")
print("Corresponding latent encodings are saved as .npy files in the same directory.")
