# ==============================================================================
# 2. MODERN PEPTIDE DATASET CLASS (Preserved Exactly)
# ==============================================================================
class PeptideDataset(Dataset):
    def __init__(self, df, has_label=True):
        self.df = df.reset_index(drop=True)
        self.has_label = has_label
        self.token = Params.dataset_params['token']
        self.max_len = Params.dataset_params['max_seq_len']
        self.pad_idx = self.token['pad']
        
    def tokenize(self, seq):
        seq_str = str(seq)[:self.max_len]
        tokens = [self.token['start']]
        for aa in seq_str:
            tokens.append(self.token.get(aa.strip(), self.token['unk']))
        tokens.append(self.token['eos'])
        return torch.tensor(tokens, dtype=torch.long)
    
    def __len__(self):
        return len(self.df)
    
    def __getitem__(self, idx):
        row = self.df.iloc[idx]
        seq_token = self.tokenize(row['seq'])
        if self.has_label and 'label' in self.df.columns:
            try:
                label = torch.tensor(float(row['label']), dtype=torch.float32)
            except Exception:
                label = torch.tensor(0.0, dtype=torch.float32)
            return seq_token, label
        return seq_token

def safe_collate(batch):
    PAD_IDX = Params.dataset_params['token']['pad']
    if isinstance(batch[0], tuple):
        seqs, labels = zip(*batch)
        labels = torch.stack(labels)
    else:
        seqs = batch
        labels = None
    lengths = torch.tensor([len(s) for s in seqs])
    padded = torch.nn.utils.rnn.pad_sequence(seqs, batch_first=True, padding_value=PAD_IDX)
    return (padded, labels) if labels is not None else padded

# ==============================================================================
# 3. INLINE ENCODING FUNCTION (Preserved Exactly)
# ==============================================================================
def encode_and_save(data_path, model_path, param, filename, save_folder):
    """Modern encoder that uses dataset_params instead of extension_dataset_params."""
    import pandas as pd
    
    hdf5_path = os.path.join(save_folder, f"{filename}.h5")
    
    # Load model
    MP = param.RNN_VAE_params.copy()
    if 'condition_length' in MP:
        del MP['condition_length']
    model = RNN_VAE(**MP).to(param.device)
    state_dict = torch.load(str(model_path), map_location=param.device)
    model.load_state_dict(state_dict)
    model.eval()
    
    # Create dataset & dataloader
    df = pd.read_csv(str(data_path), keep_default_na=False)
    dataset = PeptideDataset(df, has_label=True)
    dataloader = DataLoader(dataset, batch_size=512, shuffle=False, collate_fn=safe_collate)
    
    print(f"Encoding {len(df)} sequences...")
    all_z = []
    all_labels = []
    
    with torch.no_grad():
        for seq_tokens, labels in dataloader:
            seq_tokens = seq_tokens.to(param.device)
            (z_mu, _), _, _ = model(seq_tokens)
            all_z.append(z_mu.cpu().numpy())
            all_labels.append(labels.numpy().reshape(-1, 1))
    
    z_final = np.concatenate(all_z, axis=0)
    labels_final = np.concatenate(all_labels, axis=0)
    data_to_save = np.concatenate([z_final, labels_final], axis=1)
    
    with h5py.File(hdf5_path, 'w') as hf:
        hf.create_dataset('data', data=data_to_save, compression="gzip", chunks=True)
    
    print(f"✅ Saved encodings: {hdf5_path} | Shape: {data_to_save.shape}")
    return data_to_save

