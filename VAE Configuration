import torch
import sys
import importlib
from pathlib import Path

# ✅ Portable project path setup
PROJECT_ROOT = Path(__file__).resolve().parent.parent
if str(PROJECT_ROOT) not in sys.path:
    sys.path.insert(0, str(PROJECT_ROOT))

# Clear cached modules
for mod_name in list(sys.modules.keys()):
    if 'model' in mod_name.lower():
        del sys.modules[mod_name]

# Import model
import model.model as model_module
importlib.reload(model_module)
RNN_VAE = model_module.RNN_VAE

# Device & parameters
DEVICE = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
Z_DIM = 256

# ✅ Relative model path
MODEL_CHECKPOINT = PROJECT_ROOT / "models" / "vae_pretrain" / "model_best.ckpt"

model_params = {
    'n_vocab': 24,
    'max_seq_len': 35,
    'z_dim': Z_DIM,
    'emb_dim': 50,
    'PAD_IDX': 1,
    'device': DEVICE,
    'GRUEncoder_params': {
        'h_dim': 256,
        'biGRU': True,
        'layers': 2,
        'p_dropout': 0.2
    },
    'GRUDecoder_params': {
        'h_dim': 256,
        'p_word_dropout': 0.1,
        'p_out_dropout': 0.2,
        'skip_connetions': False
    }
}

# Initialize and load
model = RNN_VAE(**model_params).to(DEVICE)

if not MODEL_CHECKPOINT.exists():
    raise FileNotFoundError(
        f"Checkpoint not found: {MODEL_CHECKPOINT}\n"
        "Please download model weights and place them in models/vae_pretrain/"
    )

state_dict = torch.load(MODEL_CHECKPOINT, map_location=DEVICE)
model.load_state_dict(state_dict)
model.eval()

print(f"✅ Model loaded successfully with z_dim={model.z_dim}")
print(f"   Device: {DEVICE}")
print(f"   Checkpoint: {MODEL_CHECKPOINT}")
